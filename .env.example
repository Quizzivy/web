# Copy to .env and fill in. .env is gitignored and must stay that way. Vite
# reads it from this repository's root (web/vite.config.ts, envDir), and
# .env.production on top of it for `pnpm build`.
#
# Every value here is inlined into a bundle any visitor can read. Nothing
# secret belongs in a VITE_ variable; the server's settings live in
# Quizzivy/api's .env.example.

# Public value; safe in the frontend bundle (spec §5.3). The API verifies ID
# tokens against the same client id (its VITE_GOOGLE_CLIENT_ID or
# GOOGLE_CLIENT_ID), so use one value for both. Empty hides the Google button.
VITE_GOOGLE_CLIENT_ID=

VITE_API_BASE_URL=http://localhost:8080
VITE_DEFAULT_LOCALE=vi

# The two web hosts (docs/deploy.md). Empty, as here, one origin serves every
# page, which is how `make dev-web` runs. To try the two hosts locally, start
# the dev server twice (`pnpm dev --port 5174` and `pnpm dev --port 5175`),
# name those two origins here, and give Quizzivy/api the same two as
# STUDENT_APP_URL and STAFF_APP_URL, both in its CORS_ALLOWED_ORIGINS. Two
# ports of localhost, never my.localhost and portal.localhost: those are other
# sites than localhost, and the API's refresh cookie would not be sent.
VITE_STUDENT_APP_URL=
VITE_STAFF_APP_URL=

# The organisation's public details, inlined at build time and shown on the
# sign-in and system pages until R5's Organization settings hold them. Public,
# not secrets. Leave one empty to hide its line.
VITE_ORG_NAME=
VITE_ORG_FRONT_DESK_PHONE=
VITE_ORG_FRONT_DESK_HOURS=

# Pilot opt-in for rich option text; readers and editing existing rich options stay available.
VITE_RICH_OPTION_EDITOR=false
